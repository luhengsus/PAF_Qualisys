Project ID: Open PAF Visual3D Example
Package Information:
  Name: Visual3D Example
  Version: 1.0.5
  Required QTM version: 2.16.3600
  Encoding bytes: €€€€€

Root type: Subject
Default fields: [Creation date, Creation time]

Date format: Iso
Date separator: Dash
Filename filter: \.(pdf|r3w|cmo|docx)$

Types:
  Subject:
    Participant:
      Fields: [ID, Name, Sex, DOB, Dominance, Height, Weight, Sports]
      Children: [Session]
      Directory pattern: $ID$

  Session:
    Session:
      Fields: [Session ID, Test condition, Operator]
      Measurements: [Static, Dynamic]
      Analyses: [Processing Dominance,Processing Double,Export c3d,Export Matlab,Generate .trc and .sto]
      Display order: [Session ID, Test condition, Operator, Comments]
      Directory pattern: $Creation date$
      PDF guide: ..\Documentation\Marker_Guide_Sports_Marker_Set.pdf

Measurements:
  Fields:
    Measurement length: 30
    Minimum count: 1
    Maximum count: 1
    Count: 1
  Static:
    Measurement length: 1
    Measurement type: Static
    AIM models: Sports_Static.qam
  Dynamic:
    Maximum count: 50
    Count: 3
    Measurement type: Dynamic
    AIM models: Sports_Dynamic.qam

Analyses:
  Processing Dominance:
    Type: External program
    Program display name: Visual 3d
    Export session: Yes
    Export measurements: c3d
    Arguments: [/s, $WorkingDirectory$pipeline_create_workspace_Dominance.v3s]
    Template files: ['*.v3s']
    Do not wait for Application: Yes
  Processing Double:
    Type: External program
    Program display name: Visual 3d
    Export session: Yes
    Export measurements: c3d
    Arguments: [/s, $WorkingDirectory$pipeline_create_workspace.v3s]
    Template files: ['*.v3s']
    Do not wait for Application: Yes
  Export c3d:
    Type: External program
    Program display name: Visual 3d
    Export session: Yes
    Export measurements: c3d
    Arguments: [/s, $WorkingDirectory$pipeline_export_c3d.v3s]
    Template files: ['*.v3s']
    Do not wait for Application: Yes
  Generate .trc and .sto:
    Type: Instantiate template
    Export session: Yes
    Export measurements: [trc, sto]
    Template: Templates\OpensimRunProcessing.php
    Output file: log.txt
  Export Matlab:
    Type: External program
    Program display name: Matlab
    Export session: Yes
    Export measurements: mat
    Arguments: [-r, run('$WorkingDirectory$example.m')]
    Template files: ['*.m']
    Show output file: [output.txt]

Fields:
  ID:
    Type: String
    Inherit: Connect
  Name:
    Type: String
    Inherit: Connect
    Force: Yes
  DOB:
    Type: Date
    Inherit: Connect
  Dominance:
    Type: Enum
    Values: [Left, Right, None, Unknown]
    Inherit: Connect
    Default: Right
  Creation date:
    Type: Date
    Readonly: Yes
  Creation time:
    Type: TimeOfDay
    Readonly: Yes
  Session ID:
    Type: String
    Inherit: Connect
  Operator:
    Type: String
    Inherit: Copy
  Height:
    Type: Float
    Quantity: Length
    Unit: Meters
    Decimals: 2
    Inherit: Connect
    Max: 2.5
    Min: 0.50
  Weight:
    Type: Float
    Quantity: Mass
    Unit: kilograms
    Decimals: 1
    Inherit: Copy
    Max: 250
    Min: 0
  Sex:
    Type: Enum
    Values: [Unspecified, Female, Male, Other]
    Inherit: Connect
    Default: Male
  Measurement type:
    Type: String
  Test condition:
    Type: String
  Sports:
    Type: String

Columns:
  Default column definitions:
    ID:
      Width: 150
      Fields:
        Default: Filename
        Participant: ID
    Name:
      Width: 150
      Fields: 
        Participant: Name
    Created:
      Width: 65
      Field: Creation date
    Comments:
      Field: Comments
      Width: 100
