<?php
include ($template_directory . 'template_xml.php');
$result_id     = trim((string)$subject["ID"]);
$result_date   = trim((string)$session["Creation_date"]);
$result_id     = preg_replace('/[<>:"\/\\\\|?*\x00-\x1F]/', '_', $result_id);
$result_date   = preg_replace('/[<>:"\/\\\\|?*\x00-\x1F]/', '_', $result_date);
$result_date   = str_replace('-', '_', $result_date);
?> 

File_New
;

! ==================================
! Load files
! ==================================

! Load movement files and add tags.

<?
foreach($measurements as $m) {
	if(strstr($m["Used"], "True") && !strstr($m["Measurement_type"], "Static"))	{
		$path_parts = pathinfo($m["Filename"]);
?>

		File_Open 
		/FILE_NAME=<?=$working_directory . $path_parts['filename'] . ".c3d";?> 
		; 

		Assign_Tags_To_Files
		/MOTION_FILE_NAMES=<?=$working_directory . $path_parts['filename'] . ".c3d";?> 
		! /QUERY=
		/TAGS=<?=$m["Measurement_type"];?>
		;

		Assign_Tags_To_Files
		/MOTION_FILE_NAMES=<?=$working_directory . $path_parts['filename'] . ".c3d";?> 
		! /QUERY=
		/TAGS=<?=$session['Test_condition'];?> 
		;

		Assign_Tags_To_Files
		/MOTION_FILE_NAMES=<?=$working_directory . $path_parts['filename'] . ".c3d";?> 
		! /QUERY=
		/TAGS=<?=$m['Comments'];?> 
		;

<?
	}
}?> 

!====================================================
!Save frame rate so that it is available for other commands
!====================================================

Select_Active_File
/FILE_NAME=Dynamic
;

Evaluate_Expression
/EXPRESSION=PARAMETERS::POINT::RATE
/RESULT_NAME=GLOBAL::FRAME_RATE
! /RESULT_TYPE=DERIVED
! /RESULT_FOLDER=PROCESSED
;

Select_Active_File
/FILE_NAME=GLOBAL
! /QUERY=
;

Set_Pipeline_Parameter_To_Data_Value
/PARAMETER_NAME=FRAME_RATE
/SIGNAL_TYPES=DERIVED
/SIGNAL_NAMES=FRAME_RATE
/SIGNAL_FOLDER=PROCESSED
! /SIGNAL_COMPONENTS=ALL_COMPONENTS
;

!====================================================
!Interpolate and Filter
!====================================================
! Maximum gap for interpolation is set to 1/10th of frame rate

Evaluate_Expression
/EXPRESSION=GLOBAL::DERIVED::PROCESSED::FRAME_RATE * 0.1
/RESULT_NAME=GAP_WINDOW
/RESULT_TYPE=DERIVED
/RESULT_FOLDER=PROCESSED
;

Set_Pipeline_Parameter_To_Data_Value
/PARAMETER_NAME=GAP
/SIGNAL_TYPES=DERIVED
/SIGNAL_NAMES=GAP_WINDOW
/SIGNAL_FOLDER=PROCESSED
! /SIGNAL_COMPONENTS=ALL_COMPONENTS
;

Select_Active_File
/FILE_NAME=Dynamic
;

Interpolate
/SIGNAL_TYPES=TARGET
! /SIGNAL_NAMES=
! /SIGNAL_FOLDER=ORIGINAL
/MAXIMUM_GAP=::GAP
! /NUM_FIT=3
! /POLYNOMIAL_ORDER=3
;

Lowpass_Filter
/SIGNAL_TYPES=TARGET
! /SIGNAL_NAMES=
/SIGNAL_FOLDER=PROCESSED
! /RESULT_SUFFIX=
/RESULT_FOLDER=PROCESSED
! /FILTER_CLASS=BUTTERWORTH
/FREQUENCY_CUTOFF=15
! /NUM_REFLECTED=6
! /TOTAL_BUFFER_SIZE=6
! /NUM_BIDIRECTIONAL_PASSES=1
;

Lowpass_Filter
/SIGNAL_TYPES=FORCE
! /SIGNAL_NAMES=
/SIGNAL_FOLDER=PROCESSED
! /RESULT_SUFFIX=
/RESULT_FOLDER=PROCESSED
! /FILTER_CLASS=BUTTERWORTH
/FREQUENCY_CUTOFF=50
! /NUM_REFLECTED=6
! /TOTAL_BUFFER_SIZE=6
! /NUM_BIDIRECTIONAL_PASSES=1
;

Lowpass_Filter
/SIGNAL_TYPES=ANALOG
! /SIGNAL_NAMES=
/SIGNAL_FOLDER=ORIGINAL
! /RESULT_SUFFIX=
/RESULT_FOLDER=PROCESSED
! /FILTER_CLASS=BUTTERWORTH
/FREQUENCY_CUTOFF=50
! /NUM_REFLECTED=6
! /TOTAL_BUFFER_SIZE=6
! /NUM_BIDIRECTIONAL_PASSES=1
;

!====================================================
!Load static file, build and assign model
!====================================================

<?
//Find the file name of the static file
foreach($measurements as $m) {
	if(strstr($m["Used"], "True") && strstr($m["Measurement_type"], "Static"))	{
		$path_parts = pathinfo($m["Filename"]);
		$static = $path_parts['filename'] . ".c3d";
	}
}
?>

Create_Hybrid_Model
/FILE_NAME=<?=$working_directory . $static;?> 
;

! Remove prefix 'Q_' if Skeleton solver Sports marker set is used.
Remove_Prefix_From_Point_Labels
/PREFIX=Q_
! /INCLUDE_CAL_FILE=TRUE
! /OVERWRITE_C3D_FILE=FALSE
;

Select_Active_File
/FILE_NAME=<?=$working_directory . $static;?> 
! /QUERY=
;

Apply_Model_Template
/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
/MODEL_TEMPLATE=<?=$template_directory;?>Model_Pelvis_Coda.mdh
/VIEW_BUILDMODEL_RESULTS=0
;

Conditional_Statement
/ITERATION_PARAMETER_NAME=trunk_marker_set
/EXPRESSION=Data_Exists(TARGET::ORIGINAL::C7)
! /AS_INTEGER=TRUE
;

	Append_Model_Template
	/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
	/MODEL_TEMPLATE=<?=$template_directory;?>Model_Trunk.mdh
	/VIEW_BUILDMODEL_RESULTS=0
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=trunk_marker_set
;

! Lower-body template: four tracking markers per thigh/shank when all four _4 labels exist.
Conditional_Statement
/ITERATION_PARAMETER_NAME=lower_body_required_targets
/EXPRESSION=(Data_Exists(TARGET::ORIGINAL::R_IAS) &::AMP& Data_Exists(TARGET::ORIGINAL::L_IAS) &::AMP& Data_Exists(TARGET::ORIGINAL::R_IPS) &::AMP& Data_Exists(TARGET::ORIGINAL::L_IPS) &::AMP& Data_Exists(TARGET::ORIGINAL::R_TH1) &::AMP& Data_Exists(TARGET::ORIGINAL::L_TH1) &::AMP& Data_Exists(TARGET::ORIGINAL::R_TH2) &::AMP& Data_Exists(TARGET::ORIGINAL::L_TH2) &::AMP& Data_Exists(TARGET::ORIGINAL::R_TH3) &::AMP& Data_Exists(TARGET::ORIGINAL::L_TH3) &::AMP& Data_Exists(TARGET::ORIGINAL::R_SK1) &::AMP& Data_Exists(TARGET::ORIGINAL::L_SK1) &::AMP& Data_Exists(TARGET::ORIGINAL::R_SK2) &::AMP& Data_Exists(TARGET::ORIGINAL::L_SK2) &::AMP& Data_Exists(TARGET::ORIGINAL::R_SK3) &::AMP& Data_Exists(TARGET::ORIGINAL::L_SK3) &::AMP& Data_Exists(TARGET::ORIGINAL::R_FLE) &::AMP& Data_Exists(TARGET::ORIGINAL::L_FLE) &::AMP& Data_Exists(TARGET::ORIGINAL::R_FME) &::AMP& Data_Exists(TARGET::ORIGINAL::L_FME) &::AMP& Data_Exists(TARGET::ORIGINAL::R_FAL) &::AMP& Data_Exists(TARGET::ORIGINAL::L_FAL) &::AMP& Data_Exists(TARGET::ORIGINAL::R_TAM) &::AMP& Data_Exists(TARGET::ORIGINAL::L_TAM) &::AMP& Data_Exists(TARGET::ORIGINAL::R_FCC) &::AMP& Data_Exists(TARGET::ORIGINAL::L_FCC) &::AMP& Data_Exists(TARGET::ORIGINAL::R_FM1) &::AMP& Data_Exists(TARGET::ORIGINAL::L_FM1) &::AMP& Data_Exists(TARGET::ORIGINAL::R_FM2) &::AMP& Data_Exists(TARGET::ORIGINAL::L_FM2) &::AMP& Data_Exists(TARGET::ORIGINAL::R_FM5) &::AMP& Data_Exists(TARGET::ORIGINAL::L_FM5))
! /AS_INTEGER=TRUE
;

    Conditional_Statement
    /ITERATION_PARAMETER_NAME=lower_body_all_4th_markers
    /EXPRESSION=(Data_Exists(TARGET::ORIGINAL::R_TH4) &::AMP& Data_Exists(TARGET::ORIGINAL::L_TH4) &::AMP& Data_Exists(TARGET::ORIGINAL::R_SK4) &::AMP& Data_Exists(TARGET::ORIGINAL::L_SK4))
    ! /AS_INTEGER=TRUE
    ;

        Append_Model_Template
        /CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
        /MODEL_TEMPLATE=<?=$template_directory;?>Model_Cast_Lower_Body.mdh
        /VIEW_BUILDMODEL_RESULTS=0
        ;

    Conditional_Statement_End
    /ITERATION_PARAMETER_NAME=lower_body_all_4th_markers
    ;

    Conditional_Statement
    /ITERATION_PARAMETER_NAME=lower_body_missing_any_4th_marker
    /EXPRESSION=((Data_Exists(TARGET::ORIGINAL::R_TH4) &::AMP& Data_Exists(TARGET::ORIGINAL::L_TH4) &::AMP& Data_Exists(TARGET::ORIGINAL::R_SK4) &::AMP& Data_Exists(TARGET::ORIGINAL::L_SK4)) <> 1)
    ! /AS_INTEGER=TRUE
    ;

        Append_Model_Template
        /CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
        /MODEL_TEMPLATE=<?=$template_directory;?>Model_Sports_Lower_Body.mdh
        /VIEW_BUILDMODEL_RESULTS=0
        ;

    Conditional_Statement_End
    /ITERATION_PARAMETER_NAME=lower_body_missing_any_4th_marker
    ;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=lower_body_required_targets
;

Set_Subject_Weight
 /CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
 /WEIGHT=<?=$subject["Weight"]?> 
;

Set_Subject_Height
 /CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
 /HEIGHT=<?=$subject["Height"]?> 
;

Assign_Model_File
/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
/MOTION_FILE_NAMES=ALL_FILES
;

!====================================================
!Make meta data available as Text_Items in V3D
!====================================================

Select_Active_File
/FILE_NAME=GLOBAL
! /QUERY=
;

<?
if (!empty($session["Name"])) {?> 
	Set_Text_Item
	/SIGNAL_NAME=Name
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<? echo $session['Name']; ?> 
	;
<?	} 

if (!empty($subject["ID"])) {?> 
	Set_Text_Item
	/SIGNAL_NAME=ID
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<?=$subject["ID"]; ?> 
	;
<?	}

if (!empty($subject["DOB"])) { ?> 
	Set_Text_Item
	/SIGNAL_NAME=DOB
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<?=$subject['DOB'];?> 
	;
<?	}

if (!empty($subject["Weight"])) {?> 
	Set_Text_Item
	/SIGNAL_NAME=Weight
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<?echo (number_format(round(trim($subject["Weight"]),1),1).' kg');?> 
	;
<?	}
	
if (!empty($session["Comments"])) {?> 
	Set_Text_Item
	/SIGNAL_NAME=Comments
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<?=$session['Comments'];?> 
	;
<?	}

if (!empty($session["Creation_date"])) {?> 
	Set_Text_Item
	/SIGNAL_NAME=Creation_date
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<? echo (trim($session["Creation_date"]));?> 
	;
<?	}

if (!empty($session["Creation_time"])) {?> 
	Set_Text_Item
	/SIGNAL_NAME=Creation_time
	/SIGNAL_FOLDER=META
	/SIGNAL_DATA_VALUE=<? echo (trim($session["Creation_time"]));?> 
	;
<?	}
?> 

!====================================================
!Processing 
!====================================================

Select_Active_File
/FILE_NAME=ALL_FILES
! /QUERY=
;

Set_Default_Folders
! /PIPELINE=
/REPORT_TEMPLATE=<?=$template_directory;?> 
! /MODEL_TEMPLATE=
! /MOTION_FILE=
/DEFAULT_DATA=<?=$working_directory;?> 
! /DEFAULT_MODEL_TEMPLATE=
! /DEFAULT_REPORT_TEMPLATE=
! /CMO_LIBRARY_PATH=
;

! Build once after motion files are active so RIGHT_HIP and LEFT_HIP landmarks exist before virtual lab orientation is computed.
Build_Model
/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
! /REBUILD_ALL_MODELS=FALSE
! /DISPLAY_RESULTS=TRUE
;

!===========================================
!Define virtual lab orientation based on pelvis orientation
!===========================================

! Add TARGET Lab orientation (used to set orientation of Virtual lab)
! ==================================

! A unit vector is defined between the right and left hip landmarks, then rounded to yield 4 possible solutions ( +/- X-axis and +/- y-axis)
! A target is created that contains that unit_vector at every frame of data.
! The virtual_lab will be tracked by the new TARGET.
! Note this algorithm will NOT work properly if pelvis rotates along vertical axis during dynamic trials

! Create a unit vector between left and right hips
Conditional_Statement
/ITERATION_PARAMETER_NAME=sports_virtual_lab
/EXPRESSION=Data_Exists(TARGET::ORIGINAL::R_IAS) &::AMP& Data_Exists(TARGET::ORIGINAL::L_IAS)
! /AS_INTEGER=TRUE
;

	Evaluate_Expression
	/EXPRESSION=UNIT_VECTOR(
		(TARGET::ORIGINAL::R_IAS::X - TARGET::ORIGINAL::L_IAS::X), 
		(TARGET::ORIGINAL::R_IAS::Y - TARGET::ORIGINAL::L_IAS::Y), 
		(TARGET::ORIGINAL::R_IAS::Z - TARGET::ORIGINAL::L_IAS::Z)) 
	! /SIGNAL_TYPES= 
	! /SIGNAL_FOLDER=ORIGINAL 
	! /SIGNAL_NAMES= 
	/RESULT_TYPES=DERIVED 
	/RESULT_FOLDERS=VIRTUAL_LAB 
	/RESULT_NAME=HIP_VECTOR 
	! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE 
	; 

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=sports_virtual_lab
;

Conditional_Statement
/ITERATION_PARAMETER_NAME=landmark_virtual_lab
/EXPRESSION=((Data_Exists(TARGET::ORIGINAL::R_IAS) &::AMP& Data_Exists(TARGET::ORIGINAL::L_IAS)) <> 1)
! /AS_INTEGER=TRUE
;

	Evaluate_Expression
	/EXPRESSION=UNIT_VECTOR(
		(LANDMARK::ORIGINAL::RIGHT_HIP::X - LANDMARK::ORIGINAL::LEFT_HIP::X), 
		(LANDMARK::ORIGINAL::RIGHT_HIP::Y - LANDMARK::ORIGINAL::LEFT_HIP::Y), 
		(LANDMARK::ORIGINAL::RIGHT_HIP::Z - LANDMARK::ORIGINAL::LEFT_HIP::Z)) 
	! /SIGNAL_TYPES= 
	! /SIGNAL_FOLDER=ORIGINAL 
	! /SIGNAL_NAMES= 
	/RESULT_TYPES=DERIVED 
	/RESULT_FOLDERS=VIRTUAL_LAB 
	/RESULT_NAME=HIP_VECTOR 
	! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE 
	; 

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=landmark_virtual_lab
;

! Compute the median value of the unit vector
Metric_Median
/RESULT_METRIC_FOLDER=VIRTUAL_LAB
/RESULT_METRIC_NAME=_MED
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=VIRTUAL_LAB
/SIGNAL_NAMES=HIP_VECTOR
/COMPONENT_SEQUENCE=ALL
/EVENT_SEQUENCE=
/EXCLUDE_EVENTS=
/SEQUENCE_PERCENT_START=
/SEQUENCE_PERCENT_END=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
;

! Round the floats to an integer 
Evaluate_Expression 
/EXPRESSION=ROUND(METRIC::VIRTUAL_LAB::HIP_VECTOR_MED) 
! /SIGNAL_TYPES= 
! /SIGNAL_FOLDER=ORIGINAL 
! /SIGNAL_NAMES= 
/RESULT_TYPES=METRIC 
/RESULT_FOLDERS=VIRTUAL_LAB 
/RESULT_NAME=LAB_LATERAL 
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE 
; 

! Create a new TARGET that has the rounded unit vector at every frame. 
Create_Target 
/SIGNAL_NAMES=Lab orientation
! /SIGNAL_DESCRIPTION= 
/EXPRESSION=METRIC::VIRTUAL_LAB::LAB_LATERAL 
; 

Build_Model
/CALIBRATION_FILE=<?=$working_directory;?>Static*.c3d
! /REBUILD_ALL_MODELS=FALSE
! /DISPLAY_RESULTS=TRUE
;

! End of virtual lab definition 
! =========================================

! Save the model workspace before optional lower-body outputs.
File_Save_As
/FILE_NAME=<?=$working_directory . $result_id . '_' . $result_date . '_Result.cmz'; ?>
;

Conditional_Statement
/ITERATION_PARAMETER_NAME=lower_body_outputs
/EXPRESSION=(Data_Exists(TARGET::ORIGINAL::R_IAS) &::AMP& Data_Exists(TARGET::ORIGINAL::L_IAS) &::AMP& Data_Exists(TARGET::ORIGINAL::R_IPS) &::AMP& Data_Exists(TARGET::ORIGINAL::L_IPS) &::AMP& Data_Exists(TARGET::ORIGINAL::R_TH1) &::AMP& Data_Exists(TARGET::ORIGINAL::L_TH1) &::AMP& Data_Exists(TARGET::ORIGINAL::R_TH2) &::AMP& Data_Exists(TARGET::ORIGINAL::L_TH2) &::AMP& Data_Exists(TARGET::ORIGINAL::R_TH3) &::AMP& Data_Exists(TARGET::ORIGINAL::L_TH3) &::AMP& Data_Exists(TARGET::ORIGINAL::R_SK1) &::AMP& Data_Exists(TARGET::ORIGINAL::L_SK1) &::AMP& Data_Exists(TARGET::ORIGINAL::R_SK2) &::AMP& Data_Exists(TARGET::ORIGINAL::L_SK2) &::AMP& Data_Exists(TARGET::ORIGINAL::R_SK3) &::AMP& Data_Exists(TARGET::ORIGINAL::L_SK3) &::AMP& Data_Exists(TARGET::ORIGINAL::R_FLE) &::AMP& Data_Exists(TARGET::ORIGINAL::L_FLE) &::AMP& Data_Exists(TARGET::ORIGINAL::R_FME) &::AMP& Data_Exists(TARGET::ORIGINAL::L_FME) &::AMP& Data_Exists(TARGET::ORIGINAL::R_FAL) &::AMP& Data_Exists(TARGET::ORIGINAL::L_FAL) &::AMP& Data_Exists(TARGET::ORIGINAL::R_TAM) &::AMP& Data_Exists(TARGET::ORIGINAL::L_TAM) &::AMP& Data_Exists(TARGET::ORIGINAL::R_FCC) &::AMP& Data_Exists(TARGET::ORIGINAL::L_FCC) &::AMP& Data_Exists(TARGET::ORIGINAL::R_FM1) &::AMP& Data_Exists(TARGET::ORIGINAL::L_FM1) &::AMP& Data_Exists(TARGET::ORIGINAL::R_FM2) &::AMP& Data_Exists(TARGET::ORIGINAL::L_FM2) &::AMP& Data_Exists(TARGET::ORIGINAL::R_FM5) &::AMP& Data_Exists(TARGET::ORIGINAL::L_FM5))
! /AS_INTEGER=TRUE
;

Call_Script
/SCRIPT_FILE_NAME=<?=$template_directory . 'pipeline_Modelcomputing.v3s'; ?> 
! /SCRIPT_PATH=
;

!====================================================
!Save cmz
!====================================================

File_Save_As
/FILE_NAME=<?=$working_directory . $result_id . '_' . $result_date . '_Result.cmz'; ?>
;





